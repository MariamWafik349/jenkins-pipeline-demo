pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'mariamwafik333/fullstackspringbootangular_1'  // Docker Hub repository
        DOCKER_TAG = 'latest'  // Docker image tag
    }
    stages {
        stage('Checkout') {
            steps {
                // Checkout the source code from the specified branch
                git url: 'https://github.com/MariamWafik349/jenkins-pipeline-demo.git', branch: 'dev'
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    // Build the Docker image with the specified tag
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    // Access Docker Hub credentials securely
                    withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                        // Log in to Docker Hub
                        sh "echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin"
                        
                        // Push the Docker image
                        sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                // Log out of Docker Hub to clean up
                sh "docker logout"
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}

